  },
  "larchenko_ckpt4": {
    "command": ["$VLA_PYTHON", "-u", "{repo}/solutions/larchenko_2025/backend.py", "--checkpoint", "{checkpoint}", "--port", "{port}"],
    "needs_checkpoint": true,
    "per_task": false,
    "fresh_process_per_episode": false,
    "startup_timeout_s": 1200,
