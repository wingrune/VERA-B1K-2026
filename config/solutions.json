  },
  "frozen_rgbd": {
    "command": [
      "$FROZEN_RGBD_PYTHON",
      "-u",
      "{repo}/solutions/frozen_rgbd/backend.py",
      "--task",
      "{task}",
      "--port",
      "{port}"
    ],
    "needs_checkpoint": false,
    "per_task": true,
    "fresh_process_per_episode": true,
    "startup_timeout_s": 300,
    "tasks": [
      "collecting_aluminum_cans",
      "organizing_school_stuff",
      "organizing_art_supplies",
      "composting_waste",
      "boxing_books_up_for_storage"
    ]
  },
  "comet2": {
    "command": [
      "$COMET2_PYTHON",
      "-u",
      "{repo}/solutions/comet2/backend.py",
      "--checkpoint",
      "{checkpoint}",
      "--port",
      "{port}"
    ],
    "needs_checkpoint": true,
    "per_task": false,
    "fresh_process_per_episode": true,
    "startup_timeout_s": 1200,
    "tasks_from": "solutions/comet2/tasks.json",
    "action_chunk_size": 20
