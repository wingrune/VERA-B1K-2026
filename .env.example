# Copy to .env (gitignored, never copied into the Docker image) and fill in. chmod 600 .env
# Hugging Face: write token from https://huggingface.co/settings/tokens, used by scripts/push_hf.sh
HF_TOKEN=
# Hugging Face dataset repo for results and the image, e.g. my-org/b1k-2026-submission (push_hf.sh --repo overrides it)
HF_REPO=
# GitHub: fine-grained token with Contents read/write on this repository, used by scripts/git_push.sh
GITHUB_TOKEN=
# GitHub container registry: classic token with write:packages (fine-grained tokens cannot push), used by scripts/push_ghcr.sh
GHCR_TOKEN=
